# ============================================
# WETOOWIPE - Environment Variables Template
# ============================================
# Copy this file to .env and fill in values

# Discord Bot
TOKEN=
CLIENT_ID=
GUILD_ID=
CHANNEL_JOKE=
CHANNEL_LINK_DAIRO=
CHANNEL_TEST=
ADMIN_IDS=
BOT_ID=

# Go API
GO_API_URL=http://localhost:8080
API_TOKEN=
API_SECRET=

# Secrets
SECRET_KEY=

# Raider.IO
RAIDERIO_KEY=

# MongoDB
MONGO_ROOT_USERNAME=
MONGO_ROOT_PASSWORD=
MONGO_DATABASE=maindatabase
MONGO_URI=mongodb://${MONGO_ROOT_USERNAME}:${MONGO_ROOT_PASSWORD}@mongodb:27017/

# Webhooks
DISCORD_WEBHOOK_URL=

# TTS
TTS_SERVER_URL=http://localhost:7860/gradio_api/call/infer
FILE_SERVER_URL=http://localhost:8082
FILE_SERVER_INTERNAL_URL=http://file-server:80

# Guild
JURO_FRASE="Juro por mi teclado mecanico que acepto estas condiciones y no llorare por PvP verbal."
JURO_ROLE_ID=

# Voice / Channels
VOICE_CHANNEL_ID=
CARRY_CHANNEL_ID=

# App Environment (development/production)
APP_ENV=development
APP_PORT=8080
