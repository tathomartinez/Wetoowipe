{
    "swagger": "2.0",
    "info": {
        "contact": {}
    },
    "paths": {
        "/api/v1/accounts": {
            "post": {
                "description": "Create a new bank account with initial balance",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "accounts"
                ],
                "summary": "Create a new bank account",
                "parameters": [
                    {
                        "description": "Account details",
                        "name": "account",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/domain.User"
                        }
                    }
                ],
                "responses": {
                    "201": {
                        "description": "Created",
                        "schema": {
                            "$ref": "#/definitions/domain.User"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/accounts/{accountNumber}": {
            "get": {
                "description": "Get details of a bank account by account number",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "accounts"
                ],
                "summary": "Get account details",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Account number",
                        "name": "accountNumber",
                        "in": "path",
                        "required": true
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.User"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        },
        "/api/v1/accounts/{accountNumber}/deposit": {
            "post": {
                "description": "Deposit money to an account",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "transactions"
                ],
                "summary": "Deposit money",
                "parameters": [
                    {
                        "type": "string",
                        "description": "Account number",
                        "name": "accountNumber",
                        "in": "path",
                        "required": true
                    },
                    {
                        "description": "Deposit details",
                        "name": "transaction",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/api.TransactionRequest"
                        }
                    }
                ],
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "$ref": "#/definitions/domain.Transaction"
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "404": {
                        "description": "Not Found",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "$ref": "#/definitions/api.ErrorResponse"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "api.ErrorResponse": {
            "type": "object",
            "properties": {
                "error": {
                    "type": "string"
                }
            }
        },
        "api.TransactionRequest": {
            "type": "object",
            "properties": {
                "amount": {
                    "type": "number"
                },
                "description": {
                    "type": "string"
                }
            }
        },
        "domain.Transaction": {
            "type": "object",
            "properties": {
                "cuentaDestino": {
                    "description": "Opcional para retiros",
                    "type": "string"
                },
                "cuentaOrigen": {
                    "description": "Opcional para depósitos",
                    "type": "string"
                },
                "descripcion": {
                    "type": "string"
                },
                "estado": {
                    "$ref": "#/definitions/domain.TransactionStatus"
                },
                "fecha": {
                    "type": "string"
                },
                "fechaCreacion": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "monto": {
                    "type": "number"
                },
                "referencia": {
                    "type": "string"
                },
                "tipo": {
                    "$ref": "#/definitions/domain.TransactionType"
                }
            }
        },
        "domain.TransactionStatus": {
            "type": "string",
            "enum": [
                "procesada",
                "fallida",
                "pendiente",
                "revertida",
                "cancelada",
                "en_proceso",
                "exitoso"
            ],
            "x-enum-varnames": [
                "TransactionStatusProcesada",
                "TransactionStatusFallida",
                "TransactionStatusPendiente",
                "TransactionStatusRevertida",
                "TransactionStatusCancelada",
                "TransactionStatusEnProceso",
                "TransactionStatusExitoso"
            ]
        },
        "domain.TransactionType": {
            "type": "string",
            "enum": [
                "deposito",
                "retiro",
                "transferencia"
            ],
            "x-enum-varnames": [
                "TransactionTypeDeposito",
                "TransactionTypeRetiro",
                "TransactionTypeTransferencia"
            ]
        },
        "domain.User": {
            "type": "object",
            "properties": {
                "fechaCreacion": {
                    "type": "string"
                },
                "id": {
                    "type": "string"
                },
                "nombre": {
                    "type": "string"
                },
                "numeroCuenta": {
                    "type": "string"
                },
                "saldo": {
                    "type": "number"
                }
            }
        }
    }
}